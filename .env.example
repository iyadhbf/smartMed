# Copy this file to .env and fill in real local values. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 18 — create the database first:
#   createdb -U postgres smartmed
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/smartmed

# Email (console backend in development, SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SmartMed AI <no-reply@smartmed.test>
